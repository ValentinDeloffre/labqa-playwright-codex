{
  "name": "labqa-playwright",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test": "playwright test --project=chromium --grep-invert \"@known-bug|@probe\"",
    "test:all": "playwright test --grep-invert \"@known-bug|@probe\"",
    "test:headed": "playwright test --project=chromium --headed --grep-invert \"@known-bug|@probe\"",
    "test:ui": "playwright test --project=chromium --ui --grep-invert \"@known-bug|@probe\"",
    "test:debug": "playwright test --project=chromium --debug --grep-invert \"@known-bug|@probe\"",
    "test:smoke": "playwright test --project=chromium --grep @smoke",
    "test:smoke:all": "playwright test --grep @smoke",
    "test:known-bugs": "playwright test --grep @known-bug",
    "test:probes": "playwright test --grep @probe",
    "report": "playwright show-report",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@playwright/test": "^1.64.0",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
